// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  voided      Boolean  @default(false)

  auths Auth[]
}

enum AuthProvider {
  Email
  Google
}

enum BoardName {
  AQA
  Edexcel
  Pearson_Edexcel
  OCR
}

enum AgeLevelName {
  A_Level
  GCSE
}

model Auth {
  id                   String        @id @default(uuid())
  email                String?       @unique
  username             String?       @unique
  authProvider         AuthProvider? @map("auth_provider")
  clerkId              String?       @map("clerk_id")
  isActive             Boolean       @default(true) @map("is_active")
  roleId               String        @map("role_id")
  passwordResetToken   String?       @unique @map("password_reset_token")
  passwordResetExpires DateTime?     @map("password_reset_expires")
  lastUpdatedPass      DateTime?     @map("last_updated_pass")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  role            Role      @relation(fields: [roleId], references: [id])
  guardian        Guardian?
  student         Student?
  createdStudents Student[] @relation("CreatedStudents")
}

model Guardian {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  authId    String   @unique @map("auth_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  voided    Boolean  @default(false)

  auth Auth @relation(fields: [authId], references: [id])
}

model Student {
  id              String   @id @default(uuid())
  fullName        String   @map("full_name")
  authId          String   @unique @map("auth_id")
  boardAgeLevelId String?  @map("board_age_level_id")
  country         String?
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  voided          Boolean  @default(false)

  auth           Auth            @relation(fields: [authId], references: [id])
  boardAgeLevel  BoardAgeLevel?  @relation(fields: [boardAgeLevelId], references: [id])
  creator        Auth?           @relation("CreatedStudents", fields: [createdBy], references: [id])
}

model BoardAgeLevel {
  id            String        @id @default(uuid())
  boardName     BoardName     @map("board_name")
  ageLevelName  AgeLevelName  @map("age_level_name")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  students      Student[]

  @@unique([boardName, ageLevelName])
}


