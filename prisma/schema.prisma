// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  Email
  Google
}

model Auth {
  id                   String        @id @default(uuid())
  email                String?       @unique
  username             String?       @unique
  authProvider         AuthProvider? @map("auth_provider")
  clerkId              String?       @map("clerk_id")
  isActive             Boolean       @default(true) @map("is_active")
  roleId               String        @map("role_id")
  passwordResetToken   String?       @unique @map("password_reset_token")
  passwordResetExpires DateTime?     @map("password_reset_expires")
  lastUpdatedPass      DateTime?     @map("last_updated_pass")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  role            Role      @relation(fields: [roleId], references: [id])
  guardian        Guardian?
  student         Student?
  createdStudents Student[] @relation("CreatedStudents")
}

model Guardian {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  authId    String   @unique @map("auth_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  voided    Boolean  @default(false)

  auth Auth @relation(fields: [authId], references: [id])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  voided      Boolean  @default(false)

  auths Auth[]
}

model Student {
  id         String   @id @default(uuid())
  fullName   String   @map("full_name")
  authId     String   @unique @map("auth_id")
  ageGroupId String?  @map("age_group_id")
  boardId    String?  @map("board_id")
  levelId    String?  @map("level_id")
  country    String?
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  voided     Boolean  @default(false)

  auth      Auth      @relation(fields: [authId], references: [id])
  ageGroup  AgeGroup? @relation(fields: [ageGroupId], references: [id])
  board     Board?    @relation(fields: [boardId], references: [id])
  level     Level?    @relation(fields: [levelId], references: [id])
  creator   Auth?     @relation("CreatedStudents", fields: [createdBy], references: [id])
}

model AgeGroup {
  id       String    @id @default(uuid())
  name     String    @unique
  students Student[]
}

model Board {
  id       String    @id @default(uuid())
  name     String    @unique
  students Student[]
}

model Level {
  id       String    @id @default(uuid())
  name     String    @unique
  students Student[]
}
