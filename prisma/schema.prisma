// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  voided      Boolean  @default(false)

  auths Auth[]
}

enum AuthProvider {
  Email
  Google
}

enum BoardName {
  AQA
  Edexcel
  Pearson_Edexcel
  OCR
}

enum AgeLevelName {
  A_Level
  GCSE
}

model Auth {
  id                   String        @id @default(uuid())
  email                String?       @unique
  username             String?       @unique
  authProvider         AuthProvider? @map("auth_provider")
  clerkId              String?       @unique @map("clerk_id")
  isActive             Boolean       @default(true) @map("is_active")
  roleId               String        @map("role_id")
  passwordResetToken   String?       @unique @map("password_reset_token")
  passwordResetExpires DateTime?     @map("password_reset_expires")
  lastUpdatedPass      DateTime?     @map("last_updated_pass")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  role            Role      @relation(fields: [roleId], references: [id])
  guardian        Guardian?
  student         Student?
  createdStudents Student[] @relation("CreatedStudents")
}

model Guardian {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  authId    String   @unique @map("auth_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  voided    Boolean  @default(false)

  auth Auth @relation(fields: [authId], references: [id])
}

model Student {
  id              String   @id @default(uuid())
  fullName        String   @map("full_name")
  authId          String   @unique @map("auth_id")
  boardAgeLevelId String?  @map("board_age_level_id")
  country         String?
  currentStreak   Int
  longestStreak   Int
  totalXp         Int
  lastActivity    DateTime @map("last_activity")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  voided          Boolean  @default(false)

  auth          Auth           @relation(fields: [authId], references: [id])
  boardAgeLevel BoardAgeLevel? @relation(fields: [boardAgeLevelId], references: [id])
  creator       Auth?          @relation("CreatedStudents", fields: [createdBy], references: [id])
}

model BoardAgeLevel {
  id           String       @id @default(uuid())
  boardName    BoardName    @map("board_name")
  ageLevelName AgeLevelName @map("age_level_name")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  voided       Boolean      @default(false)
  students     Student[]

  @@unique([boardName, ageLevelName])
}

model QuestionType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  voided      Boolean  @default(false)

  questions Question[]

  @@map("question_types")
}

enum ContentBy {
  HUMAN
  AI
}

enum QuestionFor {
  Test
  Practice
}

enum DifficultyLevel {
  Beginner
  Intermediate
  Advanced
}

model Question {
  id                  String          @id @default(uuid())
  name                String
  questionText        String          @map("question_text")
  questionContentLink String          @map("question_content_link")
  contentBy           ContentBy       @default(HUMAN) @map("content_by")
  questionFor         QuestionFor     @default(Practice) @map("question_for")
  difficulty          Int             @default(0)
  totalMarks          Int?            @map("total_marks")
  timeLimit           Int?            @map("time_limit")
  hint                String
  explanation         String?
  givenContext        String? // Example: A ball is thrown vertically upward with an initial velocity of 20 m/s.
  findObjective       String? // Example: Calculate the maximum height reached by the ball and the time taken to reach that height.
  imageUrl            String?         @map("image_url")
  difficulty_level    DifficultyLevel @default(Beginner) @map("difficulty_level")
  stepCount           Int             @map("step_count")
  serialNo            Int             @map("serial_no")
  questionTypeId      String          @map("question_type_id")
  // module_id varchar [ref: > modules.id]
  // topic_id varchar [ref: > topics.id]
  // subtopic_id varchar [ref: > subtopics.id]
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  voided              Boolean         @default(false)

  questionType  QuestionType   @relation(fields: [questionTypeId], references: [id])
  solutionBases SolutionBase[]
}

model SolutionBase {
  id         String   @id @default(uuid())
  questionId String   @unique @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question             Question              @relation(fields: [questionId], references: [id])
  solutionMCQs         SolutionMcq[]
  solutionDescriptives SolutionDescriptive[]
}

model SolutionMcq {
  id             String   @id @default(uuid()) @map("mcq_option_id")
  solutionBaseId String   @map("solution_base_id")
  optionText     String   @map("option_text")
  isCorrect      Boolean  @default(false) @map("is_correct")
  mark           Int?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  voided         Boolean  @default(false)

  solutionBase SolutionBase @relation(fields: [solutionBaseId], references: [id])
}

model SolutionDescriptive {
  id                  String   @id @default(uuid()) @map("descriptive_id")
  solutionBaseId      String   @unique @map("solution_base_id")
  descriptiveSolution String?  @map("descriptive_solution") //correct_ans
  markingStepsJson    Json?    @map("marking_steps_json")
  maxMarks            Int?     @map("max_marks")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  voided              Boolean  @default(false)

  solutionBase SolutionBase @relation(fields: [solutionBaseId], references: [id])
}

enum ReviewStatus {
  Scheduled
  InProgress
  InReview
  Graded
}

enum ExamType {
  Competitive
  Normal
  Mock
}

enum ExamDifficulty {
  Easy
  Medium
  Hard
}

model Topic {
  id           String   @id @default(uuid())
  name         String
  description  String?
  logoFileName String?  @map("logo_file_name")
  // moduleId     String  @map("module_id")
  serialNumber Int      @map("serial_number")
  paperNumber  Int      @map("paper_number")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  voided       Boolean  @default(false)

  subtopics     Subtopic[]
  examSubtopics ExamSubtopic[]

  @@map("topics")
}

model Subtopic {
  id           String   @id @default(uuid())
  name         String
  logoFileName String?  @map("logo_file_name")
  serialNumber Int      @map("serial_number")
  content      String?
  topicId      String   @map("topic_id")
  // institutionId   String   @map("institution_id") // [ref: > institutions.id]
  // boardAgeLevelId String   @map("board_age_level_id") // [ref: > boardAgeLevels.id]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  voided       Boolean  @default(false)

  topic         Topic          @relation(fields: [topicId], references: [id])
  examSubtopics ExamSubtopic[]

  @@map("subtopics")
}

model Exam {
  id                   Int             @id @default(autoincrement())
  name                 String
  startTime            DateTime        @map("start_time")
  endTime              DateTime        @map("end_time")
  type                 ExamType
  difficulty           ExamDifficulty? // Will be called Beginner, Intermediate, Advanced for competitive exams
  timeLimit            Int?            @map("time_limit")
  maxNumberOfQuestions Int?            @map("max_number_of_questions")
  status               ReviewStatus?
  totalMarks           Int?            @map("total_marks")
  classId              String?         @map("class_id") // Only for exams assigned for a class
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  voided               Boolean         @default(false)

  subtopics ExamSubtopic[]

  @@map("exams")
}

// Maintains the many to many relationship between exams and topics and subtopics
model ExamSubtopic {
  examId     Int    @map("exam_id")
  topicId    String @map("topic_id")
  subtopicId String @map("subtopic_id")

  exam     Exam     @relation(fields: [examId], references: [id])
  topic    Topic    @relation(fields: [topicId], references: [id])
  subtopic Subtopic @relation(fields: [subtopicId], references: [id])

  @@id([examId, topicId, subtopicId])
  @@map("exam_subtopics")
}
