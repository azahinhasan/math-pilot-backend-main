model Student {
  id           String   @id @default(cuid())
  full_name    String
  auth_id      String   @unique
  age_group_id String?
  board_id     String?
  level_id     String?
  country      String?
  created_by   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  voided       Boolean  @default(false)

  auth         Auth       @relation(fields: [auth_id], references: [id])
  age_group    AgeGroup?  @relation(fields: [age_group_id], references: [id])
  board        Board?     @relation(fields: [board_id], references: [id])
  level        Level?     @relation(fields: [level_id], references: [id])
  creator      Auth?      @relation("CreatedStudents", fields: [created_by], references: [id])
}

model AgeGroup {
  id       String    @id @default(cuid())
  name     String    @unique
  students Student[]
}

model Board {
  id       String    @id @default(cuid())
  name     String    @unique
  students Student[]
}

model Level {
  id       String    @id @default(cuid())
  name     String    @unique
  students Student[]
}
